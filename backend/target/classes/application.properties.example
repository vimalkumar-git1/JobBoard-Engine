spring.application.name=career-portal

# --- Database ---
spring.datasource.url=jdbc:mysql://localhost:3306/career_portal_db
spring.datasource.username=root
spring.datasource.password=yourpassword
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# --- File uploads ---
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB
app.storage.root=./storage

# --- JWT ---
# IMPORTANT: replace with your own long random secret before running.
# Generate one with: openssl rand -base64 48
app.jwt.secret=CHANGE_ME_REPLACE_WITH_A_REAL_RANDOM_SECRET_AT_LEAST_32_BYTES
app.jwt.expiration-ms=86400000

# --- Mail (for the daily digest scheduled job) ---
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your_email@gmail.com
spring.mail.password=your_app_password
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# --- Swagger UI at /swagger-ui.html ---
springdoc.swagger-ui.path=/swagger-ui.html

# --- Job Aggregator (Adzuna — legitimate job API, NOT Naukri/LinkedIn scraping) ---
# Free signup: https://developer.adzuna.com/signup  -> gives you app-id and app-key
adzuna.app-id=YOUR_ADZUNA_APP_ID
adzuna.app-key=YOUR_ADZUNA_APP_KEY
adzuna.country=in
adzuna.search-terms=java developer,spring boot developer,full stack developer,react developer
adzuna.locations=chennai,bangalore,hyderabad,remote
adzuna.results-per-term=20
# Cron: seconds minutes hours day month weekday -> default runs daily at 6 AM
adzuna.fetch-cron=0 0 6 * * *

# --- Company ATS Aggregator (Greenhouse / Lever public job-board APIs) ---
# Format per entry: CompanyDisplayName|atsType|boardSlug   (atsType = greenhouse or lever)
company-ats.sources=Razorpay|greenhouse|razorpaysoftwareprivatelimited,Postman|greenhouse|postman,CRED|lever|cred,Meesho|lever|meesho,Groww|greenhouse-eu|groww,InMobi|greenhouse|inmobi
# Cron: default runs daily at 6:30 AM (30 min after Adzuna, to avoid overlapping load)
company-ats.fetch-cron=0 30 6 * * *
